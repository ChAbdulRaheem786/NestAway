<form action="/Favorites" method="post" class="mt-4">
  <input type="hidden" name="id" value="<%= home._id %>" />
  <button
    type="submit"
    class="w-full py-3 rounded-xl bg-gradient-to-r from-fuchsia-600 to-rose-500 text-white font-semibold shadow-lg hover:shadow-fuchsia-500/40 hover:scale-[1.02] transition-all duration-300"
  >
    Add to Favorites
  </button>
</form>
