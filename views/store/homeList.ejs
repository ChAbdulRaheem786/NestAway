<%- include('../partials/head') %>
</head>
<body class="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-slate-100 font-sans min-h-screen">
  <%- include('../partials/nav') %>

  <header class="bg-gradient-to-r from-fuchsia-600 via-rose-500 to-orange-400 text-white py-20 text-center shadow-xl">
    <h1 class="text-5xl font-extrabold mb-5 tracking-tight">
      Here are our registered Homes
    </h1>
    <p class="text-lg text-white/90">
      Browse your next comfort zone here.
    </p>
  </header>

  <main class="max-w-6xl mx-auto px-6 py-16">
    <ul class="grid md:grid-cols-2 gap-10">
      <% registeredHomes.forEach(home => { %>
        <li class="group bg-white/10 backdrop-blur-xl border border-white/10 p-6 rounded-2xl shadow-xl hover:shadow-fuchsia-500/20 transition-all duration-300 hover:-translate-y-2">
          
          <span class="text-white font-semibold text-2xl tracking-tight">
            <%= home.houseName %>
          </span>

          <div class="mt-3 space-y-1 text-slate-300">
            <p>Price: $<%= home.price %></p>
            <p>Location: <%= home.location %></p>
            <p>Rating: <%= home.rating %></p>
          </div>

          <div class="overflow-hidden rounded-xl mt-5 relative">
            <img 
              src="<%= home.photo %>" 
              alt="Photo of <%= home.houseName %>" 
              class="w-full h-56 object-cover transform group-hover:scale-110 transition duration-500"
            >
          </div>

          <!-- Buttons + Favorite Section -->
          <div class="mt-6 flex flex-col gap-4">

            <div>
              <%- include('../partials/favorite',{home:home}) %>
            </div>

            <div class="flex justify-center gap-5">

              <a 
  href="/homes/<%= home._id %>" 
  class="px-6 py-3 rounded-xl 
         bg-red-600
         text-white font-semibold shadow-lg 
         hover:bg-red-700 hover:scale-105
         transition-all duration-300"
>
  Details
</a>

              <!-- Red Button -->
              <a 
  href="/book/<%= home._id %>" 
  class="px-6 py-3 rounded-xl 
         bg-gradient-to-r from-blue-500 to-cyan-500 
         text-white font-semibold shadow-lg 
         hover:bg-red-700 hover:scale-105
         transition-all duration-300"
>
  Book Now
</a>

            </div>

          </div>

        </li>
      <% }); %>
    </ul>
  </main>

  <footer class="bg-white/5 backdrop-blur-lg border-t border-white/10 mt-20 py-8 text-center text-slate-400">
    &copy; 2026 NestAway. All rights reserved.
  </footer>

</body>
</html>