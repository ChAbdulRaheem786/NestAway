<%- include('../partials/head') %>
</head>

<body class="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-slate-100 font-sans min-h-screen">

    <%- include('../partials/nav') %>

    <main class="flex justify-center items-center px-4 py-16">
        <div class="bg-white/10 backdrop-blur-xl border border-white/10 rounded-2xl shadow-2xl w-full max-w-md p-10">

            <h1 class="text-3xl font-extrabold text-white text-center mb-3">
                Create Account
            </h1>
            <p class="text-slate-300 text-center mb-8">
                Register to continue
            </p>

            <%- include('../partials/error') %>

            <form action="/signup" method="POST" class="space-y-5">

                <div>
                    <label class="text-sm text-slate-300">First Name</label>
                    <input 
                        type="text" 
                        name="firstname" 
                        required
                        value="<%= oldInput && oldInput.firstname ? oldInput.firstname : '' %>"
                        placeholder="Enter first name"
                        class="mt-1 w-full px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-fuchsia-500 transition"
                    >
                </div>

                <div>
                    <label class="text-sm text-slate-300">Last Name</label>
                    <input 
                        type="text" 
                        name="lastname" 
                        required
                        value="<%= oldInput && oldInput.lastname ? oldInput.lastname : '' %>"
                        placeholder="Enter last name"
                        class="mt-1 w-full px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-fuchsia-500 transition"
                    >
                </div>

                <div>
                    <label class="text-sm text-slate-300">Email</label>
                    <input 
                        type="email" 
                        name="email" 
                        required
                        value="<%= oldInput && oldInput.email ? oldInput.email : '' %>"
                        placeholder="Enter email"
                        class="mt-1 w-full px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-fuchsia-500 transition"
                    >
                </div>

                <div>
                    <label class="text-sm text-slate-300">Password</label>
                    <input 
                        type="password" 
                        name="password" 
                        required
                        placeholder="Enter password"
                        class="mt-1 w-full px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-fuchsia-500 transition"
                    >
                </div>

                <div>
                    <label class="text-sm text-slate-300">Confirm Password</label>
                    <input 
                        type="password" 
                        name="confirmpassword"
                        required
                        placeholder="Confirm password"
                        class="mt-1 w-full px-4 py-3 rounded-xl bg-white/10 border border-white/20 text-white placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-fuchsia-500 transition"
                    >
                </div>

                <div>
                    <p class="text-sm text-slate-300 mb-2">User Type</p>
                    <div class="flex gap-6">

                        <label class="flex items-center gap-2 cursor-pointer">
                            <input 
                                type="radio" 
                                name="usertype" 
                                value="guest" 
                                required
                                <%= oldInput && oldInput.usertype === 'guest' ? 'checked' : '' %>
                                class="accent-fuchsia-500 w-4 h-4"
                            >
                            <span>Guest</span>
                        </label>

                        <label class="flex items-center gap-2 cursor-pointer">
                            <input 
                                type="radio" 
                                name="usertype" 
                                value="host"
                                required
                                <%= oldInput && oldInput.usertype === 'host' ? 'checked' : '' %>
                                class="accent-fuchsia-500 w-4 h-4"
                            >
                            <span>Host</span>
                        </label>

                    </div>
                </div>

                <label class="flex items-start gap-3 text-sm text-slate-300 cursor-pointer">
                    <input 
                        type="checkbox" 
                        name="terms" 
                        required
                        class="accent-fuchsia-500 mt-1"
                    >
                    <span>I agree to the terms and conditions</span>
                </label>

                <input 
                    type="submit" 
                    value="Sign Up"
                    class="w-full py-3 rounded-xl font-semibold text-white 
                    bg-gradient-to-r from-fuchsia-600 to-rose-500 
                    shadow-lg hover:scale-[1.02] 
                    hover:shadow-fuchsia-500/40 
                    transition cursor-pointer"
                >

            </form>

            <p class="text-slate-300 text-center mt-6">
                Already registered?
                <a href="/login" class="text-fuchsia-400 hover:text-rose-400 font-semibold">
                    Login
                </a>
            </p>

        </div>
    </main>

</body>
</html>
